+/* Print is a fixed 16:9 page. Do not inherit mobile viewport typography. */
+@media print {
+  .print-page .slide-frame { display:grid; grid-template-rows:64px minmax(0,1fr) 32px; }
+  .print-page .slide-content { min-height:0; padding:28px 64px 20px; }
+  .print-page .slide-copy { width:100%; max-width:100%; }
+  .print-page .slide-copy h2 { font-size:34px; line-height:1.15; max-width:48ch; }
+  .print-page .kind-title .slide-copy h2 { font-size:46px; max-width:22ch; }
+  .print-page .slide-body-copy { font-size:22px; line-height:1.45; }
+  .print-page .slide-copy ul { font-size:20px; line-height:1.4; gap:10px; }
+  .print-page .write-note { margin-top:18px; padding:18px 22px; }
+  .print-page .write-note strong { font-size:23px; line-height:1.4; }
+  .print-page .reading-entry p, .print-page .reading-entry a { font-size:18px; line-height:1.4; }
+  .print-page .topic-agenda { grid-template-columns:repeat(2,minmax(0,1fr)); }
+  .print-page .topic-agenda li>strong { font-size:21px; }
+  .print-page .topic-agenda li>span { font-size:25px; }
+  .print-page .infographic figcaption { font-size:18px; line-height:1.4; }
+  .print-page .comparison-table { font-size:21px; line-height:1.4; }
